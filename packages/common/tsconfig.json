{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,
    "strictPropertyInitialization": false,

    "declaration": true,
    "declarationMap": true,

    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
